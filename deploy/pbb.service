[Unit]
Description=PBB Pickleball tournament app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pbb
Group=pbb
WorkingDirectory=/opt/pbb
EnvironmentFile=/etc/pbb.env
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3

# The app only needs to write its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pbb

[Install]
WantedBy=multi-user.target
